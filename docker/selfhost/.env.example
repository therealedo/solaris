# Address Caddy listens on. Use ":80" to test locally on http://localhost,
# or your domain (for example solaris-test.duckdns.org) to get HTTPS automatically.
SITE_ADDRESS=:80

# Public URL players open in their browser, without a trailing slash.
SITE_URL=http://localhost

# Set to true when SITE_URL uses https.
SESSION_SECURE_COOKIES=false

# Any long random string, for example the output of: openssl rand -hex 32
SESSION_SECRET=change-me

# Optional: AI personas powered by Google Gemini. Without a key, bots use simple rules.
# Get a free key (no billing needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model with a free tier works. Flash-Lite has the most generous free limits.
GEMINI_MODEL=gemini-3.5-flash-lite
# Budget for each of the two server processes (api and jobs), so both together stay
# inside the free tier. Lower these if Google reports quota errors.
LLM_REQUESTS_PER_MINUTE=5
LLM_REQUESTS_PER_DAY=400
